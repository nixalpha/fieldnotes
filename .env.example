OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
FIELDNOTES_DATA_DIR=data
# Override LAN address detection if multiple network adapters are active.
# FIELDNOTES_LAN_IP=192.168.1.10

# Optional local visual memory (explicit setup required).
FIELDNOTES_MEMORY_MODELS=data/models
FIELDNOTES_MODEL_DEVICE=auto

# EdgeTAM: CPU is the supported default; mps is experimental.
FIELDNOTES_TRACK_DEVICE=cpu
